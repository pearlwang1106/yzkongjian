---
import type { Locale, SiteContent } from '../i18n';
import { getLocalePath, localeHreflang, localeLabels, locales } from '../i18n';

interface Props {
  content: SiteContent;
  locale: Locale;
}

const { content, locale } = Astro.props;
const { site, nav, ui } = content;
const homePath = getLocalePath(locale);
---

<header class="sticky top-0 z-50 border-b border-border bg-cream/95 backdrop-blur-sm" data-header>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 md:px-8">
    <a href={homePath} class="font-serif text-base tracking-[0.15em] text-charcoal md:text-lg">
      {site.brand}
    </a>

    <div class="flex items-center gap-6 md:gap-10">
      <nav class="hidden items-center gap-10 md:flex lg:gap-12" aria-label={ui.mainNav}>
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="text-xs font-normal uppercase tracking-[0.3em] text-charcoal transition-opacity hover:opacity-50 md:text-sm"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="relative" data-lang-switcher>
        <button
          id="lang-toggle"
          type="button"
          class="flex h-10 w-10 items-center justify-center text-charcoal transition-opacity hover:opacity-50"
          aria-label={ui.languageLabel}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="lang-menu"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18"></path>
            <path d="M12 3a14 14 0 0 1 0 18"></path>
            <path d="M12 3a14 14 0 0 0 0 18"></path>
          </svg>
        </button>

        <nav
          id="lang-menu"
          class="absolute right-0 top-full z-50 mt-2 hidden min-w-[7.5rem] border border-border bg-cream py-2 shadow-sm"
          aria-label={ui.languageLabel}
        >
          {
            locales.map((code) => (
              <a
                href={getLocalePath(code)}
                class:list={[
                  'block px-4 py-2.5 text-xs font-normal tracking-[0.15em] transition-colors md:text-sm',
                  code === locale
                    ? 'text-charcoal'
                    : 'text-stone hover:text-charcoal',
                ]}
                hreflang={localeHreflang[code]}
                aria-current={code === locale ? 'page' : undefined}
              >
                {localeLabels[code]}
              </a>
            ))
          }
        </nav>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="flex h-10 w-10 items-center justify-center md:hidden"
        aria-label={ui.openMenu}
        aria-expanded="false"
        data-open-label={ui.openMenu}
        data-close-label={ui.closeMenu}
      >
        <span class="relative block h-3 w-5">
          <span class="menu-line absolute left-0 top-0 block h-px w-full bg-charcoal transition-all"
          ></span>
          <span
            class="menu-line absolute left-0 top-1/2 block h-px w-full -translate-y-1/2 bg-charcoal transition-all"
          ></span>
          <span class="menu-line absolute bottom-0 left-0 block h-px w-full bg-charcoal transition-all"
          ></span>
        </span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-border bg-cream px-5 py-8 md:hidden"
    aria-label={ui.mobileNav}
  >
    <ul class="flex flex-col gap-6">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-xs font-normal uppercase tracking-[0.3em] text-charcoal md:text-sm"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    const openLabel = toggle.dataset.openLabel ?? 'Open menu';
    const closeLabel = toggle.dataset.closeLabel ?? 'Close menu';
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? closeLabel : openLabel);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      const openLabel = toggle?.dataset.openLabel ?? 'Open menu';
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', openLabel);
    });
  });

  const langSwitcher = document.querySelector('[data-lang-switcher]');
  const langToggle = document.getElementById('lang-toggle');
  const langMenu = document.getElementById('lang-menu');

  function setLangMenuOpen(open: boolean) {
    langMenu?.classList.toggle('hidden', !open);
    langToggle?.setAttribute('aria-expanded', String(open));
  }

  langToggle?.addEventListener('click', (event) => {
    event.stopPropagation();
    setLangMenuOpen(langMenu?.classList.contains('hidden') === true);
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node) || !langSwitcher?.contains(event.target)) {
      setLangMenuOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setLangMenuOpen(false);
    }
  });
</script>
