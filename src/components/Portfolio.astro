---
import type { SiteContent } from '../i18n';
import { imageSrc } from '../utils/image';

interface Props {
  content: SiteContent;
}

const { portfolio } = Astro.props.content;
/** Hide styles that still have no case photos (e.g. Chinese coming soon). */
const visibleProjects = portfolio.projects.filter((p) => p.images.length > 0);
const styleFilters = visibleProjects.map((p) => ({
  key: p.styleKey,
  label: p.category,
}));

const featuredProject = visibleProjects.find((p) => p.featured);
const gridProjects = visibleProjects.filter((p) => !p.featured);

/** Mosaic tiles shown beside the featured hero gallery */
const mosaicCount = 5;
const featuredMosaic = featuredProject?.images.slice(1, 1 + mosaicCount) ?? [];
---

<section id="portfolio" class="bg-cream py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-10 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div data-animate>
        <p class="section-label mb-5">{portfolio.label}</p>
        <h2 class="font-serif text-3xl font-normal text-charcoal md:text-4xl lg:text-[2.75rem]">
          {portfolio.title}
        </h2>
      </div>
      <a href="#contact" class="link-arrow shrink-0" data-animate data-delay="2">
        {portfolio.archiveLink}
        <span aria-hidden="true"></span>
      </a>
    </div>

    <div
      class="mb-12 flex flex-wrap gap-x-5 gap-y-3 border-b border-border pb-6"
      data-animate
      data-portfolio-filters
      role="tablist"
      aria-label={portfolio.title}
    >
      <button
        type="button"
        class="portfolio-filter is-active text-[11px] font-normal uppercase tracking-[0.22em] text-charcoal transition-colors"
        data-filter="all"
        role="tab"
        aria-selected="true"
      >
        {portfolio.filterAll}
      </button>
      {
        styleFilters.map((filter) => (
          <button
            type="button"
            class="portfolio-filter text-[11px] font-normal uppercase tracking-[0.22em] text-stone transition-colors hover:text-charcoal"
            data-filter={filter.key}
            role="tab"
            aria-selected="false"
          >
            {filter.label}
          </button>
        ))
      }
    </div>

    {
      featuredProject && (
        <article
          class="portfolio-card portfolio-featured mb-16 md:mb-24"
          data-animate
          data-style={featuredProject.styleKey}
        >
          <div class="mb-6 flex flex-col gap-4 md:mb-8 md:flex-row md:items-end md:justify-between md:gap-10">
            <div>
              <p class="featured-badge mb-3 text-[10px] font-normal uppercase tracking-[0.35em] text-stone">
                {portfolio.featuredBadge}
              </p>
              <h3 class="font-serif text-3xl font-normal text-charcoal md:text-4xl lg:text-[2.85rem] lg:leading-[1.1]">
                {featuredProject.title}
              </h3>
              <p class="mt-2 text-[10px] font-normal uppercase tracking-[0.25em] text-stone">
                {featuredProject.category}
              </p>
            </div>
            {featuredProject.tagline && (
              <p class="max-w-md text-sm leading-relaxed text-muted md:text-right md:text-[15px]">
                {featuredProject.tagline}
              </p>
            )}
          </div>

          <div class="featured-mosaic" data-animate="image">
            <div
              class="featured-hero relative overflow-hidden"
              data-gallery
              data-gallery-count={String(featuredProject.images.length)}
            >
              {featuredProject.images.map((src, imgIndex) => (
                <img
                  src={imageSrc(src)}
                  alt={`${featuredProject.title} — ${imgIndex + 1}`}
                  class:list={[
                    'h-full w-full object-cover transition-[opacity,transform] duration-700',
                    imgIndex === 0 ? 'relative opacity-100' : 'absolute inset-0 opacity-0',
                    'pointer-events-none',
                  ]}
                  loading={imgIndex === 0 ? 'eager' : 'lazy'}
                  data-gallery-slide
                  data-index={String(imgIndex)}
                  aria-hidden={imgIndex === 0 ? 'false' : 'true'}
                />
              ))}

              <div class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 bg-gradient-to-t from-charcoal/55 via-charcoal/20 to-transparent px-4 pb-4 pt-16 md:px-6 md:pb-5">
                <span
                  class="text-[11px] uppercase tracking-[0.2em] text-cream/95"
                  data-gallery-counter
                >
                  1 / {featuredProject.images.length}
                </span>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    class="flex h-10 w-10 items-center justify-center border border-cream/45 text-cream transition-colors hover:bg-cream/15"
                    data-gallery-prev
                    aria-label="Previous"
                  >
                    <span aria-hidden="true">‹</span>
                  </button>
                  <button
                    type="button"
                    class="flex h-10 w-10 items-center justify-center border border-cream/45 text-cream transition-colors hover:bg-cream/15"
                    data-gallery-next
                    aria-label="Next"
                  >
                    <span aria-hidden="true">›</span>
                  </button>
                </div>
              </div>
            </div>

            {featuredMosaic.map((src, i) => (
              <button
                type="button"
                class:list={['featured-tile group overflow-hidden', `featured-tile-${i + 1}`]}
                data-featured-jump
                data-index={String(i + 1)}
                aria-label={`${featuredProject.title} — ${i + 2}`}
              >
                <img
                  src={imageSrc(src)}
                  alt=""
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]"
                  loading="lazy"
                />
                <span class="pointer-events-none absolute inset-0 bg-charcoal/0 transition-colors duration-500 group-hover:bg-charcoal/10" />
              </button>
            ))}
          </div>
        </article>
      )
    }

    <div class="grid gap-16 md:grid-cols-2 lg:gap-x-16 lg:gap-y-20">
      {
        gridProjects.map((project, index) => {
          const isEvenCol = index % 2 === 0;
          const images = project.images;
          const hasGallery = images.length > 1;
          const isComingSoon = Boolean(project.comingSoon) || images.length === 0;

          return (
            <article
              class:list={[
                'group portfolio-card',
                !isEvenCol && 'layout-stagger-col-even',
                isEvenCol ? 'md:pr-4 lg:pr-8' : 'md:pl-4 lg:pl-8',
              ]}
              data-animate
              data-delay={String((index % 2) + 1)}
              data-style={project.styleKey}
            >
              <div
                class:list={[
                  'relative overflow-hidden',
                  isEvenCol ? 'layout-offset-right' : 'layout-offset-left',
                  index % 4 < 2 ? 'layout-offset-down' : 'layout-offset-up',
                ]}
                data-animate="image"
                data-gallery={hasGallery ? '' : undefined}
                data-gallery-count={String(images.length)}
              >
                {isComingSoon ? (
                  <div class="flex aspect-[3/2] w-full items-center justify-center bg-charcoal/[0.04] px-8 text-center">
                    <p class="max-w-xs text-sm leading-relaxed text-muted">{portfolio.comingSoon}</p>
                  </div>
                ) : (
                  <>
                    {images.map((src, imgIndex) => (
                      <img
                        src={imageSrc(src)}
                        alt={`${project.title} — ${imgIndex + 1}`}
                        class:list={[
                          'aspect-[3/2] w-full object-cover transition-opacity duration-500',
                          imgIndex === 0 ? 'relative opacity-100' : 'absolute inset-0 opacity-0',
                          hasGallery && 'pointer-events-none',
                        ]}
                        loading={index < 2 && imgIndex === 0 ? 'eager' : 'lazy'}
                        data-gallery-slide
                        data-index={String(imgIndex)}
                        aria-hidden={imgIndex === 0 ? 'false' : 'true'}
                      />
                    ))}

                    {hasGallery && (
                      <div class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-3 bg-gradient-to-t from-charcoal/45 to-transparent px-4 pb-3 pt-10">
                        <div class="flex flex-wrap items-center gap-1.5" data-gallery-dots>
                          {images.length <= 8
                            ? images.map((_, dotIndex) => (
                                <button
                                  type="button"
                                  class:list={[
                                    'h-1.5 w-1.5 rounded-full transition-all',
                                    dotIndex === 0 ? 'bg-cream scale-125' : 'bg-cream/45 hover:bg-cream/80',
                                  ]}
                                  data-gallery-dot
                                  data-index={String(dotIndex)}
                                  aria-label={`${dotIndex + 1} / ${images.length}`}
                                />
                              ))
                            : null}
                        </div>
                        <div class="flex items-center gap-2">
                          {images.length > 8 && (
                            <span
                              class="text-[10px] uppercase tracking-[0.18em] text-cream/90"
                              data-gallery-counter
                            >
                              1 / {images.length}
                            </span>
                          )}
                          <button
                            type="button"
                            class="flex h-8 w-8 items-center justify-center border border-cream/40 text-cream transition-colors hover:bg-cream/15"
                            data-gallery-prev
                            aria-label="Previous"
                          >
                            <span aria-hidden="true">‹</span>
                          </button>
                          <button
                            type="button"
                            class="flex h-8 w-8 items-center justify-center border border-cream/40 text-cream transition-colors hover:bg-cream/15"
                            data-gallery-next
                            aria-label="Next"
                          >
                            <span aria-hidden="true">›</span>
                          </button>
                        </div>
                      </div>
                    )}
                  </>
                )}
              </div>
              <div
                class:list={[
                  'mt-6 border-t border-border pt-6 transition-colors duration-300 group-hover:border-charcoal/30',
                  isEvenCol ? 'md:ml-6 lg:ml-10' : 'md:mr-6 lg:mr-10 md:text-right',
                ]}
              >
                <h3 class="font-serif text-xl font-normal text-charcoal md:text-2xl">
                  {project.title}
                </h3>
                <p class="mt-2 text-[10px] font-normal uppercase tracking-[0.25em] text-stone">
                  {project.category}
                </p>
                {project.tagline && (
                  <p class="mt-4 text-sm leading-relaxed text-muted">{project.tagline}</p>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  function initPortfolio() {
    const root = document.getElementById('portfolio');
    if (!root) return;

    const filters = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = root.querySelectorAll<HTMLElement>('.portfolio-card');

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.filter ?? 'all';
        filters.forEach((f) => {
          const active = f === btn;
          f.classList.toggle('is-active', active);
          f.classList.toggle('text-charcoal', active);
          f.classList.toggle('text-stone', !active);
          f.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        cards.forEach((card) => {
          const match = key === 'all' || card.dataset.style === key;
          card.classList.toggle('hidden', !match);
        });
      });
    });

    root.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      const slides = Array.from(
        gallery.querySelectorAll<HTMLImageElement>('[data-gallery-slide]'),
      );
      if (slides.length < 2) return;

      let index = 0;
      const dots = Array.from(
        gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]'),
      );
      const counter = gallery.querySelector<HTMLElement>('[data-gallery-counter]');
      const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
      const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
      let hoverTimer: number | undefined;

      const show = (nextIndex: number) => {
        index = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const on = i === index;
          slide.classList.toggle('opacity-100', on);
          slide.classList.toggle('opacity-0', !on);
          slide.classList.toggle('relative', on);
          slide.classList.toggle('absolute', !on);
          slide.classList.toggle('inset-0', !on);
          slide.setAttribute('aria-hidden', on ? 'false' : 'true');
        });
        dots.forEach((dot, i) => {
          const on = i === index;
          dot.classList.toggle('bg-cream', on);
          dot.classList.toggle('scale-125', on);
          dot.classList.toggle('bg-cream/45', !on);
        });
        if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
      };

      // Expose for mosaic jump buttons
      (gallery as HTMLElement & { __galleryShow?: (i: number) => void }).__galleryShow = show;

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          show(Number(dot.dataset.index ?? 0));
        });
      });
      prev?.addEventListener('click', (e) => {
        e.stopPropagation();
        show(index - 1);
      });
      next?.addEventListener('click', (e) => {
        e.stopPropagation();
        show(index + 1);
      });

      gallery.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) {
          hoverTimer = window.setInterval(() => show(index + 1), 2200);
        }
      });
      gallery.addEventListener('mouseleave', () => {
        if (hoverTimer !== undefined) {
          window.clearInterval(hoverTimer);
          hoverTimer = undefined;
        }
      });
    });

    const featured = root.querySelector<HTMLElement>('.portfolio-featured');
    const featuredGallery = featured?.querySelector<
      HTMLElement & { __galleryShow?: (i: number) => void }
    >('[data-gallery]');
    featured?.querySelectorAll<HTMLButtonElement>('[data-featured-jump]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const i = Number(btn.dataset.index ?? 0);
        featuredGallery?.__galleryShow?.(i);
        featuredGallery?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });
  }

  initPortfolio();
  document.addEventListener('astro:page-load', initPortfolio);
</script>

<style>
  .portfolio-filter.is-active {
    color: var(--color-charcoal, #2c2c2c);
  }

  .featured-badge {
    position: relative;
    display: inline-block;
  }

  .featured-badge::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    margin-top: 0.75rem;
    background-color: var(--color-border);
  }

  .featured-mosaic {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
  }

  .featured-hero {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
    min-height: 16rem;
  }

  .featured-tile {
    position: relative;
    aspect-ratio: 3 / 4;
    cursor: pointer;
    border: 0;
    padding: 0;
    background: transparent;
  }

  @media (min-width: 768px) {
    .featured-mosaic {
      gap: 0.85rem;
      grid-template-columns: 1.55fr 1fr 1fr;
      grid-template-rows: 14rem 14rem;
      min-height: 28.85rem;
    }

    .featured-hero {
      grid-column: 1;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }

    .featured-tile-1 {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: auto;
      height: 100%;
    }

    .featured-tile-2 {
      grid-column: 3;
      grid-row: 1;
      aspect-ratio: auto;
      height: 100%;
    }

    .featured-tile-3 {
      grid-column: 2;
      grid-row: 2;
      aspect-ratio: auto;
      height: 100%;
    }

    .featured-tile-4 {
      grid-column: 3;
      grid-row: 2;
      aspect-ratio: auto;
      height: 100%;
    }

    .featured-tile-5 {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .featured-mosaic {
      gap: 1rem;
      grid-template-columns: 1.7fr 1fr 1fr 1fr;
      grid-template-rows: 15.5rem 15.5rem;
      min-height: 32rem;
    }

    .featured-tile-5 {
      display: block;
      grid-column: 4;
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      height: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-mosaic[data-animate='image'] .featured-tile img {
      opacity: 0;
      transform: scale(1.06);
      transition:
        opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
        transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .featured-mosaic[data-animate='image'].is-visible .featured-tile img {
      opacity: 1;
      transform: scale(1);
    }

    .featured-mosaic[data-animate='image'].is-visible .featured-tile:nth-child(2) img {
      transition-delay: 80ms;
    }
    .featured-mosaic[data-animate='image'].is-visible .featured-tile:nth-child(3) img {
      transition-delay: 140ms;
    }
    .featured-mosaic[data-animate='image'].is-visible .featured-tile:nth-child(4) img {
      transition-delay: 200ms;
    }
    .featured-mosaic[data-animate='image'].is-visible .featured-tile:nth-child(5) img {
      transition-delay: 260ms;
    }
    .featured-mosaic[data-animate='image'].is-visible .featured-tile:nth-child(6) img {
      transition-delay: 320ms;
    }
  }
</style>
